# Local MQTT message broker
MQTT_HOST=15.165.248.37
MQTT_PORT=1883
MQTT_TOPIC=event
MQTT_EVENT_TOPIC=event
MQTT_CAMERA_TOPIC=camera
MQTT_STATUS_TOPIC=safety/cameras/status
MQTT_CLIENT_ID=edge-ai-001
PUBLISH_INTERVAL_SECONDS=3

DB_URL=jdbc:postgresql://localhost:15432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=YOUR_DB_PASSWORD
JWT_SECRET=local-development-jwt-secret-change-before-shared-use-32bytes
AES_SECRET_KEY=StrangeSafetyKey
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=smart-safety-media-rookies5
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_BUCKET_NAME=smart-safety-media-rookies5

# RTSP / AI pipeline
# Host Python default. In Docker, use http://host.docker.internal:18080 unless the backend is in the same compose network.
BACKEND_BASE_URL=http://localhost:18080
# Path must match cameraLoginId registered in the backend DB (e.g. cam_01, cam_02, ...)
RTSP_URL=rtsp://localhost:8554/cam_01
CAMERA_ID=cam_01
DETECTOR_MODE=real
YOLO_MODEL=yolo26n-pose.pt
YOLO_DEVICE=auto
FFMPEG_MODE=cpu
FRAME_QUEUE_MAXSIZE=2
ALLOW_MOCK_FALLBACK=true
FALL_MIN_DURATION_SECONDS=1.5
FALL_DEBOUNCE_SECONDS=10
FALL_CANDIDATE_THRESHOLD=0.7
FALL_DECISION_WINDOW=3
FALL_DECISION_REQUIRED=2
TRACKING_MODE=supervision
TRACK_THRESH=0.10
TRACK_IOU_THRESHOLD=0.15
TRACK_BUFFER=120
TRACK_FRAME_RATE=30
TRACK_MAX_MISSING_SECONDS=4
TRACKING_GRACE_PERIOD_SECONDS=4
TRACKING_RELINK_IOU_THRESHOLD=0.30
TRACKING_RELINK_CENTER_RATIO=0.70
TRACKING_RELINK_MAX_TIME_GAP_SECONDS=2.0
TRACKING_STABILITY_FALLBACK=true
TRACKING_STABILITY_FALLBACK_CAMERA_IDS=
TRACKING_DEBUG=true
POSE_DEBUG=true
POSE_DEBUG_SUMMARY_EVERY_N=60
POSE_MIN_KEYPOINT_CONFIDENCE=0.25
POSE_DEBUG_SAVE_IMAGES=false
POSE_DEBUG_IMAGE_DIR=runs/pose_debug
POSE_DEBUG_IMAGE_EVERY_N=300
POSE_TRACKING_DIAG_JSONL=true
POSE_TRACKING_DIAG_JSONL_PATH=runs/diagnostics/pose_tracking_diag.jsonl
SEQUENCE_LENGTH=30
SEQUENCE_STRIDE=15
RESIZE_SIZE=224
ACTION_MODEL=benchmark/results/lstm_yolo26n_error_augmented_compare_smoke/YOLO26n-pose=./yolo26n-pose.pt/best.pt
ACTION_DEVICE=auto
ACTION_THRESHOLD=0.3
MIN_CONSECUTIVE_FAINT=3
CAMERA_COOLDOWN_SECONDS=10
CLASSIFIER_INPUT=keypoints
SEQUENCE_MAX_TRACK_AGE_SECONDS=5
EVENT_CLIP_ENABLED=true
EVENT_CLIP_PRE_FRAMES=150
EVENT_CLIP_POST_FRAMES=150
EVENT_CLIP_COOLDOWN_SECONDS=10
EVENT_CLIP_FPS=30
EVENT_CLIP_OUTPUT_DIR=clips
EVENT_CLIP_QUEUE_SIZE=8
MAX_FRAMES=0

# Browser-safe MJPEG stream server for the web dashboard.
# Keep real RTSP credentials here, not in the frontend.
# Paths must match cameraLoginId registered in the backend DB.
VITE_STREAM_MODE=mjpeg
VITE_MJPEG_BASE_URL=http://localhost:8010
VITE_MJPEG_PORT_END=8020
VITE_MJPEG_BASE_PATH=/mjpeg
VITE_MJPEG_PROXY_MODE=false
MJPEG_HOST=0.0.0.0
MJPEG_PORT=8010
MJPEG_PORT_END=8020
MJPEG_ENABLED=true
MJPEG_FPS=8
MJPEG_WIDTH=1280
MJPEG_HEIGHT=720
MJPEG_JPEG_QUALITY=80
MJPEG_BASE_PATH=/mjpeg
MJPEG_ENABLE_OVERLAY=true
STREAM_CORS_ORIGIN=http://localhost:5173
CAMERA_1_RTSP_URL=rtsp://localhost:8554/cam_01
CAMERA_2_RTSP_URL=rtsp://localhost:8554/cam_02
CAMERA_3_RTSP_URL=rtsp://localhost:8554/cam_03
CAMERA_4_RTSP_URL=rtsp://localhost:8554/cam_04

# Optional helper scripts.
RTSP_BASE_URL=rtsp://localhost:8554
VIDEO_SIZE=1280x720
FRAMERATE=30
BLOCK_UPRIGHT_FAINT=false

# --- Gemini / VLM (docs/GEMINI_ENV_SETUP.md) ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_SERVICE_TOKEN=heyheyhey11
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_INTERNAL_VLM_ENABLED=true
AI_INTERNAL_VLM_PORT=8091
AI_WEBRTC_SYNC_ENABLED=false

# 일반 대표 스냅샷
SNAPSHOT_CAPTURE_ENABLED=false
SNAPSHOT_UPLOAD_ENABLED=false

# 이벤트 클립
CLIP_RECORDING_ENABLED=true

# VLM 전체 사용 여부
VLM_ENABLED=true

# 전체 VLM mock 비활성화
VLM_FORCE_MOCK=false

# snapshot-assist 사용 여부
VLM_SNAPSHOT_ASSIST_ENABLED=true
VLM_SNAPSHOT_ASSIST_MOCK_ANALYZE=false
